# Environment: local, ci, staging or prod. staging and prod require HTTPS and DEBUG=False.
ENVIRONMENT=local

# Django
SECRET_KEY=change-me-with-a-generated-secret-key
DEBUG=True
# Domains that serve the project, comma separated, without scheme or port.
# Required in staging and prod, where '*' is rejected. Production example: api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
APP_PORT=8000

# HTTPS in staging and prod (ignored in local and ci)
# HSTS lifetime in seconds. Raise it to 31536000 once HTTPS works on every page.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Preload is hard to undo for the whole domain: read https://hstspreload.org first.
SECURE_HSTS_PRELOAD=False
# True when a proxy terminates TLS and sends X-Forwarded-Proto: https.
USE_X_FORWARDED_PROTO=False
# Origins allowed to send POST forms, comma separated, with scheme. Usually empty.
# Example: https://admin.example.com
CSRF_TRUSTED_ORIGINS=

# Request limits for the API, as <requests>/<period>: 10/m, 10/10m, 100/6h, 1000/d.
# Empty means no limit. Anonymous clients are counted by IP, authenticated ones by user.
THROTTLE_ANON_RATE=
THROTTLE_USER_RATE=
THROTTLE_LOGIN_RATE=10/10m
THROTTLE_REGISTER_RATE=5/h
THROTTLE_PASSWORD_RATE=5/h
THROTTLE_VERIFY_EMAIL_RATE=5/h
# Proxies in front of Django that append to X-Forwarded-For. 0 uses the connection address.
# The rate limits and the audit log take the client IP from here.
TRUSTED_PROXY_COUNT=0
# Where the limits are counted. The default is per process; use Redis with several workers:
# CACHE_URL=redis://localhost:6379/0 (needs the redis package)
CACHE_URL=locmemcache://

# Audit log: extra keys to store as [REDACTED], comma separated. They match whole keys,
# ignoring case, '-' and '_'. Example: tax-id,iban
AUDIT_EXTRA_SENSITIVE_KEYS=
# Audit log: bodies larger than this are stored as a marker with their size. 0 = no limit.
AUDIT_PAYLOAD_MAX_BYTES=65536

# JWT. Each refresh returns a new refresh token and the one used stops working.
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=1
# Key that signs the tokens. Empty uses SECRET_KEY; changing it invalidates every token.
JWT_SIGNING_KEY=

# Account lockout after failed logins, in the API and the admin.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# What is locked: username, ip_address, user_agent. '+' combines, ',' separates rules.
AXES_LOCKOUT_PARAMETERS=username+ip_address

# Email, as a URL. Empty prints every email in the runserver console.
# Example: smtp+tls://apikey:<api-key>@smtp.sendgrid.net:587 (encode @ : / # ? % in the password)
EMAIL_URL=
# Or send through a provider's HTTP API with anymail: mailgun, postmark, resend, brevo,
# amazon_ses... Leave EMAIL_URL empty then, and add the ANYMAIL_* variables it needs.
# Example: EMAIL_PROVIDER=resend and ANYMAIL_RESEND_API_KEY=<api-key>
EMAIL_PROVIDER=
DEFAULT_FROM_EMAIL=webmaster@localhost

# False closes POST /api/v1/auth/register/ (403). The admin and create_admin_auto still add users.
ALLOW_PUBLIC_REGISTRATION=True

# Frontend page the password reset email links to. Required. The API replaces {uid} and
# {token}; keep the quotes, or the & breaks the line when a shell sources this file.
FRONTEND_PASSWORD_RESET_URL='http://localhost:3000/reset-password?uid={uid}&token={token}'
# Minutes a reset link works.
PASSWORD_RESET_TIMEOUT_MINUTES=60
# True: a public registration logs in only after following the link of its email.
REQUIRE_EMAIL_VERIFICATION=False
# Frontend page the verification email links to. Required only with REQUIRE_EMAIL_VERIFICATION.
FRONTEND_EMAIL_VERIFICATION_URL='http://localhost:3000/verify-email?uid={uid}&token={token}'
# Hours a verification link works.
EMAIL_VERIFICATION_TIMEOUT_HOURS=24

# Origins allowed to call /api/ from a browser, comma separated, each with its scheme and
# port and without a trailing slash. Empty allows none. "*" is refused.
# Example: https://app.example.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Lists: items per page by default, and the most a client can ask for with ?page_size=.
API_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# Who sees /api/schema/ and /api/docs/. Empty: anyone in local and ci, staff only in staging and prod.
API_DOCS_ENABLED=

# Logs on the console: DEBUG, INFO, WARNING, ERROR or CRITICAL, as text or json.
LOG_LEVEL=INFO
LOG_FORMAT=text

# Docker Compose project
COMPOSE_PROJECT_NAME=saas
DB_CONTAINER_NAME=saas_db
# File the app service (docker compose --profile app) reads its variables from. Empty: .env.
APP_ENV_FILE=

# Database
DB_NAME=saas_db
DB_USER=saas_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Seconds a connection is reused across requests. Set 0 behind PgBouncer in transaction mode.
DB_CONN_MAX_AGE=60

# Superuser created by the create_admin_auto command
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Password policy for the API and the admin
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SYMBOL=True
