# Environment Configuration
ENVIRONMENT=local

# Django Core
# IMPORTANT: This is an insecure key. A new one will be generated for production.
SECRET_KEY='django-insecure-dummy-key-for-local-development'
DEBUG=True
ALLOWED_HOSTS='*'

# Database
DB_NAME=saas_db
DB_USER=saas_user
DB_PASSWORD=saas_password
DB_HOST=localhost
DB_PORT=5432

# Superuser credentials for automatic creation
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password
