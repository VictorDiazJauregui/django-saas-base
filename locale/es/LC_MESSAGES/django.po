#: security/templates/security/emails/duplicate_registration/body.html:1
#: security/templates/security/emails/duplicate_registration/body.txt:1
msgid ""
"Someone tried to create an account with this email, but it already has one. "
"Nothing changed in your account."
msgstr "Alguien intentó crear una cuenta con este email, pero ya tiene una. Su cuenta no cambió."

#: security/templates/security/emails/duplicate_registration/body.html:2
#: security/templates/security/emails/duplicate_registration/body.txt:3
msgid ""
"If it was you, log in as usual or reset your password if you forgot it. If "
"it wasn't you, you can ignore this email."
msgstr "Si fue usted, inicie sesión como siempre o restablezca la contraseña si la olvidó. Si no fue usted, puede ignorar este email."

#: security/templates/security/emails/duplicate_registration/subject.txt:1
msgid "Someone tried to register with your email"
msgstr "Alguien intentó registrarse con su email"

#: security/templates/security/emails/email_verification/body.html:1
#: security/templates/security/emails/email_verification/body.txt:1
msgid ""
"To finish creating your account, confirm this is your email by opening this "
"link:"
msgstr "Para terminar de crear su cuenta, confirme que este es su email abriendo este enlace:"

#: security/templates/security/emails/email_verification/body.html:3
#: security/templates/security/emails/email_verification/body.txt:5
#, python-format
msgid ""
"The link expires in %(hours)s hour. If it expires, ask for a new one from "
"the app."
msgid_plural ""
"The link expires in %(hours)s hours. If it expires, ask for a new one from "
"the app."
msgstr[0] "El enlace vence en %(hours)s hora. Si vence, pida uno nuevo desde la app."
msgstr[1] "El enlace vence en %(hours)s horas. Si vence, pida uno nuevo desde la app."
msgstr[2] "El enlace vence en %(hours)s horas. Si vence, pida uno nuevo desde la app."

#: security/templates/security/emails/email_verification/body.html:4
#: security/templates/security/emails/email_verification/body.txt:10
msgid "If you didn't create an account, ignore this email."
msgstr "Si no creó una cuenta, ignore este email."

#: security/templates/security/emails/email_verification/subject.txt:1
msgid "Confirm your email"
msgstr "Confirme su email"

#: security/templates/security/emails/password_reset/body.html:1
#: security/templates/security/emails/password_reset/body.txt:1
msgid ""
"Someone asked to reset the password of your account. To choose a new one, "
"open this link:"
msgstr "Alguien pidió restablecer la contraseña de su cuenta. Para elegir una nueva, abra este enlace:"

#: security/templates/security/emails/password_reset/body.html:3
#: security/templates/security/emails/password_reset/body.txt:5
#, python-format
msgid "The link works once and expires in %(minutes)s minute."
msgid_plural "The link works once and expires in %(minutes)s minutes."
msgstr[0] "El enlace funciona una sola vez y vence en %(minutes)s minuto."
msgstr[1] "El enlace funciona una sola vez y vence en %(minutes)s minutos."
msgstr[2] "El enlace funciona una sola vez y vence en %(minutes)s minutos."

#: security/templates/security/emails/password_reset/body.html:4
#: security/templates/security/emails/password_reset/body.txt:10
msgid ""
"If you didn't ask for it, ignore this email: your password stays the same."
msgstr "Si no lo pidió, ignore este email: su contraseña no cambia."

#: security/templates/security/emails/password_reset/subject.txt:1
msgid "Reset your password"
msgstr "Restablecer la contraseña"

#: security/templates/security/lockout.html:4
msgid "Account locked"
msgstr "Cuenta bloqueada"

#: security/templates/security/lockout.html:4
msgid "Django site admin"
msgstr "Sitio de administración de Django"

#: security/templates/security/lockout.html:11
#, python-format
