#: security/api_docs.py:114
msgid "Returns an access and a refresh token. Repeated failures lock the account for a while and answer 429 with the code account_locked_out. A user with two-factor authentication gets mfa_required and an mfa_token instead, for POST /api/v1/auth/login/2fa/."
msgstr "Devuelve un token access y uno refresh. Los fallos repetidos bloquean la cuenta por un tiempo y responden 429 con el código account_locked_out. Un usuario con autenticación en dos pasos recibe en cambio mfa_required y un mfa_token, para POST /api/v1/auth/login/2fa/."

#: security/api_key_schema.py:15
msgid "Api-Key <key>. Only with API_KEYS_ENABLED=True; the keys are created in the admin."
msgstr "Api-Key <key>. Solo con API_KEYS_ENABLED=True; las keys se crean en el admin."

