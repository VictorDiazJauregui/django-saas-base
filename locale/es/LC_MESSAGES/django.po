msgstr "Recibe el mfa_token del login, que vale 5 minutos, y un código o un código de recuperación. "

#: security/two_factor_serializers.py:11
msgid "Invalid or expired code."
msgstr "Código inválido o vencido."

#: security/two_factor_serializers.py:12
msgid "Start the setup first."
msgstr "Primero empiece la activación."

#: security/two_factor_serializers.py:13
